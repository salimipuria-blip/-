# Add ONLY through Vercel > Project > Settings > Environment Variables; never commit real values.
ENGINE_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
# Optional free-tier model keys (use accounts WITHOUT billing attached). Any one is enough.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides. OpenRouter models must end with ":free" or the provider is refused.
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PROVIDER_ORDER=groq,cerebras,gemini,openrouter
# Optional durable task history (Supabase free tier). All three or none; any missing => history disabled.
# Use the PUBLISHABLE key only (sb_publishable_...). Never put the service-role/secret key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 24-256 random chars (e.g. 32 random bytes, base64url). Only its SHA-256 is stored in poors_private.history_secret.
HISTORY_SECRET=
